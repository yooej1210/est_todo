// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  nickname  String
  password  String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt       @map("updated_at") @db.Timestamptz(6)

  todos      Todo[]
  categories Category[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(50)
  
  color     String   @default("#D6EAF3") @db.VarChar(7)
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt       @map("updated_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // [cite: 65, 67]
  todos     Todo[]

  @@unique([userId, name])
  @@index([userId])
  @@map("categories")
}

model Todo {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  categoryId   String?   @map("category_id") @db.Uuid
  
  text         String    // 일정/할 일 내용
  
  // 시간 관련 필드 추가
  startDate    DateTime? @map("start_date") @db.Timestamptz(6) // 시작일시
  endDate      DateTime? @map("end_date") @db.Timestamptz(6)   // 종료일시
  isAllDay     Boolean   @default(false) @map("is_all_day")    // 하루 종일 여부
  
  isCompleted  Boolean   @default(false) @map("is_completed")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt       @map("updated_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, startDate]) // 시작일 기준 조회가 많으므로 인덱스 변경
  @@index([userId, isCompleted])
  @@map("todos")
}

